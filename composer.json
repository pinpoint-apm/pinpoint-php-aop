{
    "name": "pinpoint-apm/pinpoint-php-aop",
    "description": "A simple Aop library via php-parse",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "eeliu",
            "email": "dl_cd_pinpoint@navercorp.com"
        }
    ],
    "require": {
        "php": "^7.1 || ^8.0",
        "ext-json": "*",
        "ext-pinpoint-php": "^0.5.2"
    },
    "autoload": {
        "psr-4": {
            "Pinpoint\\": "lib/Pinpoint/"
        },
        "files": [
            "lib/Pinpoint/Plugins/functions.php"
        ]
    },
    "minimum-stability": "dev",
    "require-dev": {
        "phpunit/phpunit": "^8"
    },
    "require": {
        "php": ">=7",
        "nikic/php-parser": "^4.1"
    }
}